# Copy to .env and fill in what you have. .env is git-ignored; this template holds no secrets.

# Model provider (one is enough). AGENT_PROVIDER forces a choice when several keys are set.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AGENT_PROVIDER=

# Web research. TinyFish (search + browser-rendered page fetching) is used first, then Brave.
TINYFISH_API_KEY=
BRAVE_API_KEY=

# Optional per-run limits and unit prices for spend tracking.
# AGENT_MAX_SEARCHES=6
# AGENT_MAX_FETCHES=12
# AGENT_MAX_RUN_USD=1.00
# AGENT_PRICE_IN_PER_MTOK=
# AGENT_PRICE_OUT_PER_MTOK=
# AGENT_PRICE_PER_SEARCH=
# AGENT_PRICE_PER_FETCH=
